# GradeAI Configuration
# Copy this file to .env and adjust variables as needed

# Security
SECRET_KEY=gradeai-super-secret-production-grade-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite in local backend data directory
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/gradeai
DATABASE_URL=sqlite:///./data/gradeai.db

# Storage Directories (relative to backend or absolute)
UPLOAD_DIR=./data/uploads
MODEL_DIR=./data/models
REPORTS_DIR=./data/reports

# AI and OCR Pipeline
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Set if Tesseract is installed outside standard system PATH (Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_PATH=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Binding
HOST=127.0.0.1
PORT=8000
DEBUG=True
